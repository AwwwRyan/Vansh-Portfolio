---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../site';
import photo from '../assets/vansh.jpeg';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// Absolute URLs need `site` set in astro.config.mjs; until then they stay relative.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const ogImage = await getImage({ src: photo, width: 400, format: 'jpg' });
const ogImageUrl = abs(ogImage.src);
const pageUrl = abs(Astro.url.pathname);
const [firstName, ...lastName] = site.fullName.split(' ');

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  image: ogImageUrl,
  sameAs: [site.linkedin],
  ...(Astro.site && { url: pageUrl }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#344e37" />
    <meta name="format-detection" content="telephone=no" />
    {Astro.site && <link rel="canonical" href={pageUrl} />}

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook, Slack…) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content={`Portrait of ${site.fullName}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content={firstName} />
    <meta property="profile:last_name" content={lastName.join(' ')} />
    {Astro.site && <meta property="og:url" content={pageUrl} />}

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={ogImage.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz@6..96&family=Gloock&family=Montserrat:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
